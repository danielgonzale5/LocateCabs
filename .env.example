# Copy to .env and fill in, or run `npm run init-env` to generate one with random secrets.

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=locatecabs
DB_USER=locatecabs
DB_PASS=[INSERT_DB_PASSWORD]
# Only used by docker compose to initialise MySQL
DB_ROOT_PASS=[INSERT_DB_ROOT_PASSWORD]

# Operator login for the web UI. APP_PASSWORD_HASH comes from `npm run hash-password`.
APP_USER=operator
APP_PASSWORD_HASH=[INSERT_SCRYPT_HASH]

# One key per device, id:64 hex characters, comma separated.
# Generate a key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICE_KEYS=taxi1:[INSERT_64_HEX_CHARACTERS]

# Deploy webhook. Leave the secret empty to disable the /github route.
GITHUB_WEBHOOK_SECRET=
DEPLOY_DIR=
DEPLOY_BRANCH=master

# Optional
# HTTP_PORT=3000
# UDP_PORT=3020
# TRUST_PROXY=1   # set when running behind exactly one reverse proxy
